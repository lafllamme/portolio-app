# Supabase — backend for storage and the resume download
NUXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-or-publishable-key
NUXT_SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# GitHub — powers the contribution calendar. Classic PAT, read:user scope.
NUXT_GITHUB_TOKEN=ghp_EXAMPLEonlyREPLACEmeEXAMPLEonlyREPLA

# Resume download — password-gated PDF, served as a signed URL
NUXT_RESUME_DOWNLOAD_BUCKET=resume
NUXT_RESUME_DOWNLOAD_FILE_EN=latest.pdf
NUXT_RESUME_DOWNLOAD_FILE_DE=latest_de.pdf
NUXT_RESUME_DOWNLOAD_PASSWORD=L33T
NUXT_RESUME_DOWNLOAD_SIGNED_URL_TTL_SECONDS=604800
